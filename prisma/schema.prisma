datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Hero {
  id          Int      @id @default(1)
  badgeText   String
  title       String
  titleAccent String
  description String
  image       String
  updatedAt   DateTime @updatedAt
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  details     String
  icon        String
  image       String
  features    String // Stored as JSON string
  specs       String // Stored as JSON string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model About {
  id          Int      @id @default(1)
  title       String
  subtitle    String
  description String
  address     String
  mapUrl      String
  features    String // Stored as JSON string
  updatedAt   DateTime @updatedAt
}
